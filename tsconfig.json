{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build"
  },
  // Exclusions d'Adonis + l'audit des boucles, qui tourne sur le code du front (alias ~/) et non dans le serveur
  "exclude": [
    "${configDir}/inertia/**",
    "${configDir}/scripts/audit-boucles/**",
    "${configDir}/node_modules/**",
    "${configDir}/build/**",
    "${configDir}/bower_components/**",
    "${configDir}/jspm_packages/**"
  ],
  "references": [{ "path": "./tsconfig.inertia.json" }]
}
