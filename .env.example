# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=alpas

# Calcul d'itinéraires : laisser vide en local (BRouter du VPS, profil « alpas »), /brouter en production
VITE_BROUTER_URL=

# Mot de passe oublié (vide en local : le lien s'affiche dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Connexion avec Google / Strava (vide : bouton masqué)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=